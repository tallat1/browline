{
  "sourceLanguage": "tr",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browline"
          }
        }
      }
    },
    "NSAppleEventsUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To control what's playing in Music and Spotify, and to open the right Claude window from a decision card."
          }
        }
      }
    },
    "NSAudioCaptureUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So the bars can react to the playing music by reading the live frequency balance of the audio. Audio is never recorded or sent anywhere."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows upcoming meetings in the notch and opens their join link."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So you can see yourself in the Mirror tab. Nothing is recorded or sent anywhere."
          }
        }
      }
    },
    "NSDesktopFolderUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To save screenshots you drop on the shelf and to write converted files next to their originals."
          }
        }
      }
    },
    "NSDocumentsFolderUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To save converted files next to their originals in Documents."
          }
        }
      }
    },
    "NSDownloadsFolderUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To show downloads in the notch and to save zipped or converted files to Downloads."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To show today's reminders in the Calendar tab and mark them as completed."
          }
        }
      }
    }
  },
  "version": "1.0"
}

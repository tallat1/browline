{
  "sourceLanguage": "tr",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchMVP"
          }
        }
      }
    },
    "NSAppleEventsUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When MediaRemote is unavailable, controls play/pause and track changes in Music and Spotify."
          }
        }
      }
    },
    "NSAudioCaptureUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So the bars can react to the playing music by reading the live frequency balance of the audio. Audio is never recorded or sent anywhere."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows upcoming meetings in the notch and opens their join link."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So you can see yourself in the Mirror tab. Nothing is recorded or sent anywhere."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To show today's reminders in the Calendar tab and mark them as completed."
          }
        }
      }
    }
  },
  "version": "1.0"
}

    "Betikler, AI ajanları ve Kestirmeler (Kabuk Betiği Çalıştır) yerel soketle etkinlik gönderir: notch push --id build --title Derleme --progress 40%. Yalnız sizin kullanıcınız bağlanabilir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scripts, AI agents and Shortcuts (Run Shell Script) send activities over a local socket: notch push --id build --title Build --progress 40%. Only your user account can connect."
          }
        }
      }
    },
    "Betikler, AI ajanları ve Kestirmeler buraya etkinlik gönderebilir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scripts, AI agents, and Shortcuts can send activities here."
          }
        }
      }
    },

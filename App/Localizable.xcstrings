      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory"
          }
        }
      }
    },
    "Betikler, AI ajanları ve Kestirmeler (Kabuk Betiği Çalıştır) notch'a etkinlik gönderebilir: notch push --id build --title Derleme --progress 40%. Yalnız sizin kullanıcınız erişebilir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scripts, AI agents and Shortcuts (Run Shell Script) can send activities to the notch: notch push --id build --title Build --progress 40%. Only your user account can connect."
          }
        }
      }
    },
    "Betikler, AI ajanları ve Kestirmeler buraya etkinlik gönderebilir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scripts, AI agents, and Shortcuts can send activities here."
          }
        }
      }
    },
    "Bir limit dolarsa ne zaman sıfırlanacağı burada görünür. Kullanım yüzdelerini yalnız terminaldeki Claude Code bildiriyor.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you hit a limit, when it resets shows here. Only Claude Code in the terminal reports usage percentages."
          }
        }
      }
    },
    "Biraz sonra kendiliğinden yeniden denenecek.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It will retry on its own shortly."
          }
        }
      }
    },
    "Birkaç saniyelik bildirim; diğer etkinliklerin önüne geçer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A notification for a few seconds; it goes in front of other activities."
          }
        }
      }
    },

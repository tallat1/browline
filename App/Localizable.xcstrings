      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirror (camera access is asked only on first use)"
          }
        }
      }
    },
    "Ayna için kamera izni gerekiyor. Görüntü kaydedilmez, hiçbir yere gönderilmez.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mirror needs camera access. Nothing is recorded or sent anywhere."
          }
        }
      }
    },

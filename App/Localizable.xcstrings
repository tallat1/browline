    "Önceki kilit sırasında uygulama beklenmedik biçimde kapandı; özellik güvenlik için kapatıldı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app quit unexpectedly during the previous lock; the feature was turned off for safety."

    "Başlıksız etkinlik": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Untitled event"
          }
        }
      }
    },
    "Betikler, AI ajanları ve Kestirmeler (Kabuk Betiği Çalıştır) notch'a etkinlik gönderebilir: notch push --id build --title Derleme --progress 40%. Yalnız sizin kullanıcınız erişebilir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scripts, AI agents and Shortcuts (Run Shell Script) can send activities to the notch: notch push --id build --title Build --progress 40%. Only your user account can connect."
          }
        }
      }
    },
    "Birkaç saniyelik bildirim; diğer etkinliklerin önüne geçer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A notification for a few seconds; it goes in front of other activities."
          }
        }
      }
    },
    "Bu macOS sürümünde kullanılamıyor (SkyLight sembolleri yok).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not available on this macOS version (SkyLight symbols missing)."
          }
        }
      }
    },
